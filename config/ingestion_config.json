{
  "batch": [
    {
      "datasource": "farmia",
      "dataset": "ventas",
      "source": {
        "format": "json",
        "path": "/Volumes/mastermsg001dbr/default/landing/ventas",
        "schema_hints": "id long, producto string, cantidad integer, fecha string"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/ventas",
        "partition_columns": ["fecha"]
      }
    },
    {
      "datasource": "farmia",
      "dataset": "inventario",
      "source": {
        "format": "csv",
        "path": "/Volumes/mastermsg001dbr/default/landing/inventario",
        "schema_hints": "id_producto long, stock integer, fecha string"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/inventario",
        "partition_columns": ["fecha"]
      }
    },
    {
      "datasource": "farmia",
      "dataset": "meteorologia",
      "source": {
        "format": "parquet",
        "path": "/Volumes/mastermsg001dbr/default/landing/meteorologia",
        "schema_hints": "fecha string, temperatura double, humedad double"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/meteorologia",
        "partition_columns": ["fecha"]
      }
    },
    {
      "datasource": "farmia",
      "dataset": "proveedores",
      "source": {
        "format": "avro",
        "path": "/Volumes/mastermsg001dbr/default/landing/proveedores",
        "schema_hints": "id_proveedor long, nombre string, fecha string"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/proveedores",
        "partition_columns": ["fecha"]
      }
    },
    {
      "datasource": "farmia",
      "dataset": "imagenes",
      "source": {
        "format": "binaryFile",
        "path": "/Volumes/mastermsg001dbr/default/landing/imagenes"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/imagenes",
        "partition_columns": []
      }
    }
  ],
  "streaming": [
    {
      "datasource": "farmia",
      "dataset": "eventos_clientes",
      "source": {
        "format": "kafka",
        "kafka_properties_file": "config/client.properties",
        "options": {
          "subscribe": "eventos_clientes",
          "startingOffsets": "earliest"
        },
        "key_format": "string",
        "key_subject": "eventos_clientes-key",
        "value_format": "avro",
        "value_subject": "eventos_clientes-value"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/eventos_clientes",
        "partition_columns": []
      }
    },
    {
      "datasource": "farmia",
      "dataset": "sensores_iot",
      "source": {
        "format": "kafka",
        "kafka_properties_file": "config/client.properties",
        "options": {
          "subscribePattern": "sensores_.*",
          "startingOffsets": "earliest"
        },
        "key_format": "string",
        "key_subject": "sensores-key",
        "value_format": "json",
        "value_subject": "sensores-value",
        "json_schema": "sensor_id string, temperatura double, humedad double, timestamp string"
      },
      "sink": {
        "format": "delta",
        "path": "/Volumes/mastermsg001dbr/default/bronze/sensores_iot",
        "partition_columns": []
      }
    }
  ]
}